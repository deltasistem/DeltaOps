{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "export NODE_ENV=development && pnpm run build && pnpm run start",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "seed:demo": "DELTAOPS_DB_ROLE=owner tsx ./src/seed/seed-delta-demo.ts",
    "m365:graph:smoke": "tsx ./scripts/m365-graph-smoke.ts",
    "openapi:identity": "tsx ./scripts/generar-openapi-identity.ts",
    "test": "DELTAOPS_DB_ROLE=owner vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "@workspace/dynamic-forms": "workspace:*",
    "@workspace/kernel": "workspace:*",
    "@workspace/module-abastecimiento": "workspace:*",
    "@workspace/module-activos": "workspace:*",
    "@workspace/module-analytics": "workspace:*",
    "@workspace/module-correctivo": "workspace:*",
    "@workspace/module-costos": "workspace:*",
    "@workspace/module-inventario": "workspace:*",
    "@workspace/module-manodeobra": "workspace:*",
    "@workspace/module-ordenes": "workspace:*",
    "@workspace/module-planes": "workspace:*",
    "@workspace/module-preventivo": "workspace:*",
    "@workspace/module-reference": "workspace:*",
    "@workspace/module-utilizacion": "workspace:*",
    "@workspace/platform": "workspace:*",
    "bcryptjs": "^3.0.3",
    "connect-pg-simple": "^10.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "drizzle-orm": "catalog:",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/connect-pg-simple": "^7.0.3",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/node": "catalog:",
    "esbuild": "0.27.3",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13.1.3",
    "thread-stream": "3.1.0",
    "tsx": "catalog:",
    "vitest": "^4.1.10"
  }
}
