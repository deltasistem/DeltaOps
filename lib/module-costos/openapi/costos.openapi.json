    "/api/deltaops/costos/hechos": {
      "get": {
        "tags": [
          "Consulta"
        ],
        "operationId": "costos.hechos",
        "summary": "Listar hechos económicos (por OT/activo/movimiento/artículo/tipo/moneda/período/estado)",
        "parameters": [
          {
            "name": "otId",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Filtro por OT"
          },
          {
            "name": "activoId",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Filtro por activo"
          },
          {
            "name": "movimientoId",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "DGP-021.2 · Filtro por movimiento de inventario (trazabilidad de origen)"
          },
          {
            "name": "articuloId",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "DGP-021.2 · Filtro por artículo/ítem"
          },
          {
            "name": "tipo",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "MATERIAL | COMBUSTIBLE | MANO_DE_OBRA | OTROS"
          },
          {
            "name": "naturaleza",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "DGP-021.2 (R1) · CARGO (costo) | ABONO (crédito/devolución)"
          },
          {
            "name": "moneda",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Filtro por moneda (serie por moneda; nunca se suman)"
          },
          {
            "name": "estado",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "ACTIVO | ANULADO"
          },
          {
            "name": "desde",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "ocurridoAt >= (ISO)"
          },
          {
            "name": "hasta",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "ocurridoAt < (ISO)"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "hechos": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Hecho"
                      }
                    }
                  },
                  "required": [
                    "hechos"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "401": {
            "description": "No autenticado (sesión ausente)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "No autorizado (KRN-AUTH)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
