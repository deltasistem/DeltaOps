                }
              }
            }
          }
        }
      }
    },
    "/api/deltaops/costos/composicion/ot/{otId}": {
      "get": {
        "tags": [
          "Composición"
        ],
        "operationId": "costos.composicion.ot",
        "summary": "Composición de costos de mantenimiento de una OT (mano de obra + materiales + otros)",
        "description": "Compone por moneda (sin conversión, §6) el costo económico de la OT: mano de obra (valoraciones de DGP-020.3), materiales y otros (hechos económicos de module-costos, CARGO−ABONO), y los PENDIENTES de materialización. El COMBUSTIBLE es NO_APLICA en la OT (sin contrato de atribución combustible→OT, GAP-FUEL-OT). NO usa el costoReal manual de la OT (§13). Dinero string-safe.",
        "parameters": [
          {
            "name": "otId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Orden de trabajo (leída bajo el tenant de sesión; IDOR-safe)"
          },
          {
            "name": "periodo",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Período por fechas REALES del hecho (§10): actual | 30d | 90d | anio | rango | total (omitido ⇒ total)."
          },
          {
            "name": "desde",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Con periodo=rango: límite inferior ISO (inclusive)."
          },
          {
            "name": "hasta",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Con periodo=rango: límite superior ISO (inclusive)."
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ComposicionOt"
                }
              }
            }
          },
          "401": {
            "description": "No autenticado (sesión ausente)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "No autorizado (KRN-AUTH)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "No encontrado (KRN-NF)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/deltaops/costos/composicion/activo/{activoId}": {
      "get": {
        "tags": [
          "Composición"
        ],
        "operationId": "costos.composicion.activo",
        "summary": "Composición del costo operacional/histórico de un activo",
        "description": "Compone por moneda (sin conversión) el costo del activo: mano de obra, materiales, otros y COMBUSTIBLE CONTEXTUAL (tanqueos de DGP-019, separado del total económico y marcado como valor de origen no-exacto, GAP-FUEL-MONEY). Preparado para DGP-021.4 (costo/hora por horómetro, costo/km por odómetro). Dinero económico string-safe.",
        "parameters": [
          {
            "name": "activoId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Activo (leído bajo el tenant de sesión; IDOR-safe)"
          },
          {
            "name": "periodo",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Período por fechas REALES del hecho (§10): actual | 30d | 90d | anio | rango | total (omitido ⇒ total)."
          },
          {
            "name": "desde",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Con periodo=rango: límite inferior ISO (inclusive)."
          },
          {
            "name": "hasta",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Con periodo=rango: límite superior ISO (inclusive)."
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ComposicionActivo"
                }
              }
            }
          },
          "401": {
            "description": "No autenticado (sesión ausente)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "No autorizado (KRN-AUTH)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "No encontrado (KRN-NF)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          },
          "code": {
            "type": "string",
            "example": "KRN-VAL-001"
          }
        },
        "required": [
          "error",
          "code"
        ],
        "additionalProperties": false
      },
      "ResultadoComando": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "idempotente": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      },
      "MaterializarMaterial": {
        "type": "object",
        "properties": {
          "opId": {
            "type": "string",
            "minLength": 8,
            "maxLength": 200,
            "pattern": "^[\\x21-\\x7e]+$",
            "description": "Clave de idempotencia OBLIGATORIA (invariante): 8..200 caracteres imprimibles ASCII sin espacios. Un reintento con el mismo opId devuelve el mismo resultado sin duplicar."
          },
          "costoId": {
            "type": "string",
            "format": "uuid"
          },
          "otId": {
            "type": "string",
            "description": "OT verificada por contrato público; el activo se DERIVA de la relación canónica"
          },
          "articuloId": {
            "type": "string",
            "description": "Artículo cuyo costo EXACTO se snapshotea (DGP-021.0)"
          },
          "movimientoId": {
            "type": "string",
            "description": "DGP-021.2 ANTI-BYPASS (§20): movimiento de inventario de ORIGEN (OBLIGATORIO). MATERIAL sólo se materializa desde un movimiento físico confirmado; la orquestación de servicio deriva el opId determinista inv:<movimientoId>. NO existe MATERIAL manual."
          },
          "familia": {
            "type": "string",
            "description": "DGP-021.2 (R1): FAMILIA contable del movimiento (auditoría). Deriva la NATURALEZA del hecho: 'devolucion' ⇒ ABONO (crédito compensatorio); consumo/salida ⇒ CARGO. Se registra cruda en fuente.familia. Omitida ⇒ CARGO."
          },
          "cantidad": {
            "type": "string",
            "pattern": "^\\d{1,12}(\\.\\d{1,6})?$",
            "description": "Monto/cantidad en PUNTO FIJO como CADENA decimal (string-only; \\d{1,12}(\\.\\d{1,6})?). Un número JSON es rechazado."
          },
          "unidad": {
            "type": "string"
          },
          "moneda": {
            "type": "string",
            "description": "Moneda del hecho; debe existir costo exacto en esa moneda (SIN COSTO ≠ 0)"
          },
          "ocurridoAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "opId",
          "otId",
          "articuloId",
          "movimientoId",
          "cantidad",
          "unidad",
          "moneda"
        ],
        "additionalProperties": false
      },
      "MaterializarOtros": {
        "type": "object",
        "properties": {
          "opId": {
            "type": "string",
            "minLength": 8,
            "maxLength": 200,
            "pattern": "^[\\x21-\\x7e]+$",
            "description": "Clave de idempotencia OBLIGATORIA (invariante): 8..200 caracteres imprimibles ASCII sin espacios. Un reintento con el mismo opId devuelve el mismo resultado sin duplicar."
          },
          "costoId": {
            "type": "string",
            "format": "uuid"
          },
          "otId": {
            "type": "string"
          },
          "concepto": {
            "type": "string",
            "description": "Concepto auditable del costo manual (origen no es texto libre suelto)"
          },
          "cantidad": {
            "type": "string",
            "pattern": "^\\d{1,12}(\\.\\d{1,6})?$",
            "description": "Monto/cantidad en PUNTO FIJO como CADENA decimal (string-only; \\d{1,12}(\\.\\d{1,6})?). Un número JSON es rechazado."
          },
          "unidad": {
            "type": "string"
          },
          "costoUnitario": {
            "type": "string",
            "pattern": "^\\d{1,12}(\\.\\d{1,6})?$",
            "description": "Monto/cantidad en PUNTO FIJO como CADENA decimal (string-only; \\d{1,12}(\\.\\d{1,6})?). Un número JSON es rechazado."
          },
          "moneda": {
            "type": "string"
          },
          "ocurridoAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "opId",
          "otId",
          "concepto",
          "cantidad",
          "unidad",
          "costoUnitario",
          "moneda"
        ],
        "additionalProperties": false
      },
      "AnularHecho": {
        "type": "object",
        "properties": {
          "opId": {
            "type": "string",
            "minLength": 8,
            "maxLength": 200,
            "pattern": "^[\\x21-\\x7e]+$",
            "description": "Clave de idempotencia OBLIGATORIA (invariante): 8..200 caracteres imprimibles ASCII sin espacios. Un reintento con el mismo opId devuelve el mismo resultado sin duplicar."
          },
          "motivo": {
            "type": "string",
            "description": "Motivo auditable de la anulación"
          }
        },
        "required": [
          "opId",
          "motivo"
        ],
        "additionalProperties": false
      },
      "Hecho": {
        "type": "object",
        "properties": {
          "costoId": {
            "type": "string"
          },
          "tipo": {
            "type": "string",
            "enum": [
              "MATERIAL",
              "COMBUSTIBLE",
              "MANO_DE_OBRA",
              "OTROS"
            ]
          },
          "naturaleza": {
            "type": "string",
            "enum": [
              "CARGO",
              "ABONO"
            ],
            "description": "DGP-021.2 (R1) · signo SEMÁNTICO del ledger: CARGO = costo (consumo), ABONO = crédito compensatorio (devolución). Importes SIEMPRE no negativos; el signo lo lleva este campo, nunca un monto negativo."
          },
          "originType": {
            "type": "string"
