# DeltaOps · DGP-001 — Variables de entorno
# Copie a .env para desarrollo local fuera de Replit (en Replit las gestiona
# el entorno: base de datos y SESSION_SECRET ya están provisionados).
# NUNCA commitee valores reales.

# Entorno: development | test | production
NODE_ENV=development

# PostgreSQL (obligatoria). En docker-compose la provee el servicio "db".
DATABASE_URL=postgres://deltaops:deltaops@localhost:5432/deltaops

# Secreto de firma de cookies de sesión (obligatoria).
SESSION_SECRET=cambie-este-valor

# Nivel de log de pino (opcional): trace|debug|info|warn|error
LOG_LEVEL=info

# Puertos (los inyecta el orquestador; solo para ejecución manual)
# PORT=8080
# BASE_PATH=/deltaops/

# --- Seed de desarrollo (DGP-017) ---
# Contraseñas de los usuarios de demostración. En DESARROLLO/TEST, si se omiten,
# el seed usa un default DERIVADO y no secreto por usuario (ver
# artifacts/api-server/src/seed/seed-credentials.ts). En PRODUCCIÓN son
# OBLIGATORIAS (el seed falla si faltan). NO commitee valores reales.
# DEMO_ADMIN_PASSWORD=
# DEMO_SUPERVISOR_PASSWORD=
# DEMO_PLANIFICADOR_PASSWORD=
# DEMO_TECNICO_PASSWORD=
# DEMO_CONSULTA_PASSWORD=
# DELTAOPS_ADMIN_PASSWORD=
