# DeltaOps · DGP-001 — Variables de entorno
# Copie a .env para desarrollo local fuera de Replit (en Replit las gestiona
# el entorno: base de datos y SESSION_SECRET ya están provisionados).
# NUNCA commitee valores reales.

# Entorno: development | test | production
NODE_ENV=development

# PostgreSQL (obligatoria). En docker-compose la provee el servicio "db".
DATABASE_URL=postgres://deltaops:deltaops@localhost:5432/deltaops

# Secreto de firma de cookies de sesión (obligatoria).
SESSION_SECRET=cambie-este-valor

# Nivel de log de pino (opcional): trace|debug|info|warn|error
LOG_LEVEL=info

# Puertos (los inyecta el orquestador; solo para ejecución manual)
# PORT=8080
# BASE_PATH=/deltaops/

# --- Seed de desarrollo (DGP-017) ---
# Contraseñas de los usuarios de demostración. En DESARROLLO/TEST, si se omiten,
# el seed usa un default DERIVADO y no secreto por usuario (ver
# artifacts/api-server/src/seed/seed-credentials.ts). En PRODUCCIÓN son
# OBLIGATORIAS (el seed falla si faltan). NO commitee valores reales.
# DEMO_ADMIN_PASSWORD=
# DEMO_SUPERVISOR_PASSWORD=
# DEMO_PLANIFICADOR_PASSWORD=
# DEMO_TECNICO_PASSWORD=
# DEMO_CONSULTA_PASSWORD=
# DELTAOPS_ADMIN_PASSWORD=

# --- Notificaciones por correo (Microsoft 365 / SMTP OAuth) ---
# Selección de proveedor: fake | m365. Default fake (dev/test).
# En PRODUCCIÓN con m365, si la config es inválida el arranque FALLA (sin
# fallback silencioso). NUNCA commitee secretos reales.
# NOTIFICATION_PROVIDER=fake
#
# Microsoft 365 / Exchange Online (SMTP + OAuth2 client_credentials).
# Ver docs/deltaops/identidad-tenancy/email-m365.md.
# M365_MAIL_ENABLED=false
# M365_TENANT_ID=            # tenant de Entra ID (NO es el tenant de DeltaOps)
# M365_CLIENT_ID=            # App Registration (client id)
# M365_CLIENT_SECRET=        # secreto de la App Registration (SOLO por secret manager)
# M365_MAIL_FROM=            # buzón/remitente autorizado (SMTP AUTH habilitado)
# M365_SMTP_HOST=smtp.outlook.com
# M365_SMTP_PORT=587
# M365_SMTP_SECURE=false     # false = STARTTLS en 587
# Opcionales (Configuration First): endpoint/scope/timeout/reintentos.
# M365_OAUTH_TOKEN_ENDPOINT= # override (soberanía de nube); default login.microsoftonline.com
# M365_OAUTH_SCOPE=https://outlook.office365.com/.default
# M365_TIMEOUT_MS=15000
# M365_MAX_REINTENTOS=2
