# DeltaOps · DGP-001 — Imagen del frontend (vite build + preview estático)
FROM node:22-alpine AS build
RUN corepack enable
WORKDIR /app
ARG BASE_PATH=/deltaops/
ENV BASE_PATH=$BASE_PATH PORT=5173
COPY pnpm-workspace.yaml package.json pnpm-lock.yaml ./
COPY tsconfig.base.json tsconfig.json ./
COPY lib ./lib
COPY artifacts/deltaops ./artifacts/deltaops
RUN pnpm install --frozen-lockfile
RUN pnpm --filter @workspace/deltaops run build

FROM node:22-alpine
RUN corepack enable && npm i -g serve@14
WORKDIR /app
COPY --from=build /app/artifacts/deltaops/dist/public ./public
ENV PORT=5173
EXPOSE 5173
CMD ["sh", "-c", "serve -s public -l $PORT"]
